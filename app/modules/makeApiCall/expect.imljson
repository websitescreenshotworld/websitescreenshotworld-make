[
  {
    "name": "url",
    "type": "text",
    "label": "URL",
    "required": true,
    "help": "A path relative to `https://api.websitescreenshotworld.com/instant-snap/v1`, such as `/captures` or `/account`."
  },
  {
    "name": "method",
    "type": "select",
    "label": "Method",
    "required": true,
    "default": "GET",
    "options": [
      {
        "label": "GET",
        "value": "GET"
      },
      {
        "label": "POST",
        "value": "POST"
      },
      {
        "label": "DELETE",
        "value": "DELETE"
      }
    ]
  },
  {
    "name": "headers",
    "type": "array",
    "label": "Headers",
    "help": "The API key is added for you.",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ]
  },
  {
    "name": "qs",
    "type": "array",
    "label": "Query string",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ]
  },
  {
    "name": "body",
    "type": "any",
    "label": "Body",
    "help": "A JSON body, for POST."
  }
]

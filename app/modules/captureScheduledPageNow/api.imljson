{
  "url": "/web-pages/{{encodeURL(parameters.web_page_id)}}/trigger-now",
  "method": "POST",
  "body": {},
  "response": {
    "output": {
      "{{...}}": "{{body}}",
      "triggered_at": "{{if(body.triggered_at, parseDate(body.triggered_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.triggered_at)}}"
    }
  }
}

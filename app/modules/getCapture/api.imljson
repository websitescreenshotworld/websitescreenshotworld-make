{
  "url": "/captures/{{encodeURL(parameters.capture_id)}}",
  "method": "GET",
  "response": {
    "output": {
      "{{...}}": "{{body}}",
      "captured_at": "{{if(body.captured_at, parseDate(body.captured_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.captured_at)}}",
      "expires_at": "{{if(body.expires_at, parseDate(body.expires_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.expires_at)}}"
    }
  }
}

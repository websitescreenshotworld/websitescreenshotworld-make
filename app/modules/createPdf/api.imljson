[
  {
    "url": "/captures",
    "method": "POST",
    "body": {
      "{{...}}": "{{if(parameters.proxy.country, omit(parameters, 'full_page'), omit(parameters, 'full_page', 'proxy'))}}",
      "media_category": "pdf",
      "response_type": "json",
      "async": true,
      "scroll_mode": "{{if(parameters.full_page && parameters.format === 'image_pdf', 'scroll', 'viewport')}}"
    },
    "response": {
      "temp": {
        "id": "{{body.id}}",
        "status": "{{body.status}}",
        "capture": "{{body}}"
      }
    }
  },
  {
    "condition": "{{temp.status === 'queued' || temp.status === 'running' || temp.status === 'pending'}}",
    "url": "/captures/{{temp.id}}",
    "method": "GET",
    "repeat": {
      "condition": "{{temp.status === 'queued' || temp.status === 'running' || temp.status === 'pending'}}",
      "delay": 3000,
      "limit": 40
    },
    "response": {
      "temp": {
        "status": "{{body.status}}",
        "capture": "{{body}}"
      }
    }
  },
  {
    "condition": "{{temp.status !== 'succeeded'}}",
    "url": "/captures/{{temp.id}}",
    "method": "GET",
    "response": {
      "temp": {
        "status": "{{body.status}}",
        "capture": "{{body}}"
      },
      "valid": {
        "condition": "{{body.status === 'succeeded'}}",
        "message": "{{if(body.status === 'queued' || body.status === 'running' || body.status === 'pending', 'The capture has not finished yet; read it later with Get a capture. ', '')}}Capture {{body.id}}: {{body.status}} ({{ifempty(body.error_code, 'no error code')}}; page HTTP status {{ifempty(body.page_http_status, 'none')}}). Failed captures are not charged."
      }
    }
  },
  {
    "condition": "{{temp.status === 'succeeded'}}",
    "url": "{{temp.capture.download_url}}",
    "method": "GET",
    "headers": {
      "x-api-key": ""
    },
    "response": {
      "type": "binary",
      "output": {
        "{{...}}": "{{temp.capture}}",
        "captured_at": "{{if(temp.capture.captured_at, parseDate(temp.capture.captured_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), temp.capture.captured_at)}}",
        "expires_at": "{{if(temp.capture.expires_at, parseDate(temp.capture.expires_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), temp.capture.expires_at)}}",
        "fileName": "capture-{{temp.capture.id}}.pdf",
        "data": "{{body}}"
      }
    }
  }
]

{
  "condition": "{{body.type === 'capture.changed'}}",
  "respond": {
    "status": 200,
    "type": "json",
    "body": {
      "received": true
    }
  },
  "output": {
    "{{...}}": "{{body}}",
    "created_at": "{{if(body.created_at, parseDate(body.created_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.created_at)}}",
    "data": {
      "{{...}}": "{{body.data}}",
      "captured_at": "{{if(body.data.captured_at, parseDate(body.data.captured_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.captured_at)}}"
    }
  }
}

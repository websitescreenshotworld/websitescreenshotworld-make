{
  "url": "{{connection.apiBase}}/webhook-endpoints",
  "method": "POST",
  "headers": {
    "x-api-key": "{{connection.apiKey}}"
  },
  "body": {
    "url": "{{webhook.url}}",
    "events": [
      "capture.changed"
    ],
    "name": "Make: Page Changes"
  },
  "response": {
    "data": {
      "externalHookId": "{{body.id}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.x-api-key",
      "request.body.url",
      "response.body.url",
      "response.body.signing_secret"
    ]
  }
}

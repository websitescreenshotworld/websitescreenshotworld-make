{
  "url": "/webhook-endpoints",
  "method": "POST",
  "body": {
    "url": "{{webhook.url}}",
    "events": [
      "sitemap_run.completed"
    ],
    "name": "Make: Sitemap Runs Completed"
  },
  "response": {
    "data": {
      "externalHookId": "{{body.id}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.x-api-key",
      "request.body.url",
      "response.body.url",
      "response.body.signing_secret"
    ]
  }
}

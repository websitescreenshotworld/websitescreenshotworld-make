{
  "condition": "{{body.type === 'sitemap_run.completed'}}",
  "respond": {
    "status": 200,
    "type": "json",
    "body": {
      "received": true
    }
  },
  "output": {
    "{{...}}": "{{body}}",
    "created_at": "{{if(body.created_at, parseDate(body.created_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.created_at)}}",
    "data": {
      "{{...}}": "{{body.data}}",
      "run_at": "{{if(body.data.run_at, parseDate(body.data.run_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.run_at)}}",
      "completed_at": "{{if(body.data.completed_at, parseDate(body.data.completed_at, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.completed_at)}}"
    }
  }
}
